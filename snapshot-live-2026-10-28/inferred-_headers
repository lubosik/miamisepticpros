#   Live assets with a Cache-Control also send a matching Expires header. Cache-Control takes precedence, so Expires is not ported.

# LIVE PARITY: every live response (HTML, assets, 301s and 404s) carries these two headers.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN

# LIVE PARITY: /_next/static/*
/_next/static/*
  Cache-Control: public, max-age=2592000

# LIVE PARITY: /apple-touch-icon.png
/apple-touch-icon.png
  Cache-Control: public, max-age=31536000

# LIVE PARITY: /favicon-16x16.png
/favicon-16x16.png
  Cache-Control: public, max-age=31536000

# LIVE PARITY: /favicon-32x32.png
/favicon-32x32.png
  Cache-Control: public, max-age=31536000

# LIVE PARITY: /favicon.ico
/favicon.ico
  Cache-Control: public, max-age=31536000

# LIVE PARITY: /images/*
/images/*
  Cache-Control: public, max-age=31536000

